<body class="background-blur">

    <p class="intro-text">Welcome to the museum!</p>

    <h1 class="level-header">LEVEL ONE : THE DOOR</h1>
    <main class="game-box">
        <div class="level-box">
            <p class="level-objective">Solve this riddle to pass through the door</p>
            <p class ="level-main">
                I have a home of marble stone, <br>
                Where centuries gather, quiet and lone <br>
                I hold the crown,the bone, the art, <br>
                And beat with historys frozen Heart. <br>
                Though silent am I, I speak of the past- <br>
                What am I? <br>
            </p>
        </div>
        <form class="answer" action="submit" method="POST">
            <input type="text" placeholder="Type answer here..."> 
        </form>

    </main>

