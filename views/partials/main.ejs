<body class="background-blur">

    <p class="intro-text"><%= introText %></p>

    <h1 class="level-header"><%= levelHeader %></h1>
        <main class="game-box">
            <div class="level-box">
                <p class="level-objective"><%= levelObjective %></p>
                <p class ="level-main">
                    <%= levelMain %>
                </p>
            </div>
            <form class="answer" action="/play/<%= route %>" method="POST">
                <% if (level == 1 || level == 3 ||  level == 4 ||  level == 5 ) { %>
                    <input type="text" name="userAnswer" placeholder="Type answer here..." required> 
                <% }else if(level == 2){  %> 
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <button type="submit" class="submit">Submit</button>
                <% }else{ %>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <button type="submit" class = "submit">Submit</button>
                <% } %>
            </form>


        </main>
        <script>
            const tiles = [...document.querySelectorAll('.tile')];
            tiles.forEach((tile, i) => {
            tile.addEventListener('input', () => {
                if (tile.value && tiles[i + 1]) tiles[i + 1].focus();
            });
                tile.addEventListener('keydown', e => {
                if (e.key === 'Backspace' && !tile.value && tiles[i - 1]) {
            tiles[i - 1].focus();
            }
        });
        });
</script>
</body>
</html>