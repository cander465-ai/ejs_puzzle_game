<body class="background-blur">

    <p class="intro-text"><%= introText %></p>

    <h1 class="level-header"><%= levelHeader %></h1>
        <main class="game-box">
            <div class="level-box">
                <p class="level-objective"><%= levelObjective %></p>
                <p class ="level-main">
                    <%= levelMain %>
                </p>
            </div>
            <form class="answer" action="/play/<%= route %>" method="POST">
                <% if (level == 1 || 3 || 4 || 5 ) { %>
                    <input type="text" name="userAnswer" placeholder="Type answer here..." required> 
                <% }else{  %> 
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <input type="text" class="tile" name="letters[]" maxlength="1" required>
                    <button type="submit" class="submit-btn">Check</button>
                <% } %>
            </form>


        </main>

</body>
</html>